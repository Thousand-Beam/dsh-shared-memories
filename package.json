{
  "name": "dsh-shared-memories",
  "version": "0.3.0",
  "description": "Git-native external brain and full-state roaming engine for DeepSeek Harness — snapshot on shutdown, restore on boot.",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "state-roaming",
    "temporal-tree",
    "git"
  ],
  "license": "MIT",
  "author": "The dsh-shared-memories Authors",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*",
    "scripts/wrap-client.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "entry": "./lib/client.js",
      "platform": "web",
      "immediately": true,
      "inject": [
        "slots",
        "locale"
      ]
    },
    "engines": {
      "dsh": ">=0.2.1-rc.3"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/wrap-client.mjs",
    "build:client": "tsc -p tsconfig.client.json && node scripts/wrap-client.mjs",
    "check:client": "node scripts/wrap-client.mjs --check",
    "watch": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "pretest": "tsc -p tsconfig.test.json",
    "test": "node --test \".test-build/test/**/*.spec.js\"",
    "test:watch": "tsc -p tsconfig.test.json --watch --preserveWatchOutput",
    "preview:build": "tsc -p preview/tsconfig.preview.json",
    "preview": "npm run preview:build && node preview/server.mjs 5199",
    "self-test": "node scripts/self-test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh": ">=0.2.1-rc.3",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
